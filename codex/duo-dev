#!/bin/bash
set -euo pipefail
umask 077
repo=/workspace/repos/Campsite-for-duo
case "${1:-help}" in
  init)
    if [ ! -d "$repo/.git" ]; then
        git clone git@github.com:ReliOptic/Campsite-for-duo.git "$repo"
    fi
    cd "$repo"
    printf '[duo] checkout: '; git rev-parse --short HEAD
    printf '[duo] ready at %s; no automatic checkout/pull/reset of existing work.
' "$repo"
    ;;
  test)
    cd "$repo"
    npm ci --ignore-scripts --no-audit
    npm run build
    npm test
    npm run test:project
    printf '[duo] Linux verification completed. Apple build/Simulator/device tests require macOS/Xcode.
'
    ;;
  status)
    cd "$repo"
    git status --short --branch
    ;;
  *)
    printf 'duo-dev init | test | status
Repository: /workspace/repos/Campsite-for-duo
GitHub key is read-only; pushing/PR automation is not enabled.
'
    ;;
esac
